<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#5B3FB5"
            android:gravity="center"
            android:text="Routine Manager"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Department -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Select Department"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/spDept"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Semester -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Select Semester"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/spSemester"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Select Section"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/spSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Routine Title"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/edtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/edit_text"
            android:hint="Example: Spring 2026 Routine"
            android:padding="10dp" />

        <!-- PDF Link -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Google Drive PDF Link"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/edtPdf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:drawable/edit_text"
            android:hint="Paste Google Drive link here"
            android:inputType="textUri"
            android:padding="10dp" />

        <!-- Buttons -->
        <Button
            android:id="@+id/btn_Load"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Load Existing (Edit)" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Save / Update Routine" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="#D32F2F"
            android:text="Delete Routine"
            android:textColor="@android:color/white" />

    </LinearLayout>
</ScrollView>
